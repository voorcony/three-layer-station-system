# ─────────────────────────────────────────────
# Three-Layer Station System v3 — .env Example
# ─────────────────────────────────────────────

# Shopify 店铺域名 (不含 https://)
SHOPIFY_STORE=your-store.myshopify.com

# Storefront API Token — 用于创建购物车和结算链接
# 来源: Shopify Admin → Settings → Apps → Develop apps → 选你的 Custom App → Storefront API access token
SHOPIFY_STOREFRONT_TOKEN=your_sto...token

# Admin API Token — 用于创建一次性折扣码 (必备)
# 来源: Shopify Admin → Settings → Apps → Develop apps → 选你的 Custom App → Admin API integration → 勾选 write_discounts + read_discounts
# 格式: shpat_...
SHOPIFY_ADMIN_TOKEN=your_adm...token

# 单位商品信息 (普货站 = 店铺里真实在售的商品)
# Unit product config
UNIT_PRICE=100
UNIT_VARIANT_GID=gid://shopify/ProductVariant/45069946945672

# API Auth
API_AUTH_KEY=apk_b9a7c3d1e5f80

# Optional: Shopify Webhook Secret (订单同步用，可选)
# SHOPIFY_WEBHOOK_SECRET=your_w...secret

# 普货站自身地址
BASE_URL=http://your-server-ip-or-domain
DOMAIN_NAME=your-server-ip-or-domain

# SQLite 数据库路径
DATABASE_PATH=/opt/three-layer-stations/orders.db

# 管理后台
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_password
